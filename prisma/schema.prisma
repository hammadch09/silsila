// Silsila — Prisma schema
// Docs: https://pris.ly/d/prisma-schema
//
// This is a starting point, not a final data model. It covers the Phase 1
// waitlist intake (see product.md §5) and a minimal spine for the Phase 2
// daily-task loop so relations, enums and migrations are wired end to end.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Phase 1 — landing page + waitlist intake
// ---------------------------------------------------------------------------

enum WeeklyHours {
  THREE_TO_FIVE
  FIVE_TO_TEN
  TEN_PLUS
}

enum LaptopAccess {
  YES
  SOMETIMES
  PHONE_ONLY
}

enum WaitlistStatus {
  PENDING
  PLAN_SENT
  ACTIVATED
  DROPPED
}

/// One completed intake form. `whatsapp` is the identity — students here do not
/// check email (product.md §5).
model WaitlistEntry {
  id         String         @id @default(cuid())
  whatsapp   String         @unique
  university String
  department String
  semester   Int
  goal       String // free text; "not sure yet" is a valid answer
  hours      WeeklyHours
  laptop     LaptopAccess
  status     WaitlistStatus @default(PENDING)
  source     String? // utm / referral, for Phase 4 distribution
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user User?

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Phase 2 — the daily loop
// ---------------------------------------------------------------------------

enum TaskType {
  SKILL
  HORIZON
  ARTIFACT
  SIGNAL
  HUMAN
}

enum SubmissionStatus {
  SUBMITTED
  REVIEWED
  NEEDS_REWORK
}

model User {
  id        String   @id @default(cuid())
  whatsapp  String   @unique
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  waitlistEntryId String?        @unique
  waitlistEntry   WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id], onDelete: SetNull)

  trackId String?
  track   Track?  @relation(fields: [trackId], references: [id], onDelete: SetNull)

  submissions Submission[]
}

/// A curated track template (web dev, data/AI, design, ...). Content is
/// authored, not LLM-generated per user (product.md §3).
model Track {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tasks Task[]
  users User[]
}

/// One day's task within a track. `dayIndex` is the position in the template.
model Task {
  id           String   @id @default(cuid())
  trackId      String
  track        Track    @relation(fields: [trackId], references: [id], onDelete: Cascade)
  dayIndex     Int
  type         TaskType
  title        String
  body         String
  estimateMins Int      @default(40)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  submissions Submission[]

  @@unique([trackId, dayIndex])
  @@index([type])
}

/// Proof of work. A link, a file URL, or a few lines of text — never a checkbox.
model Submission {
  id       String           @id @default(cuid())
  userId   String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId   String
  task     Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  status   SubmissionStatus @default(SUBMITTED)
  proofUrl String?
  proofText String?
  review   String? // AI or pod-lead feedback

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([taskId])
}
