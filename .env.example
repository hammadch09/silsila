# Copy to .env and fill in.
# Postgres connection string used by Prisma and the app.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/silsila_dev?schema=public"

# Only needed if your dev user cannot create databases (managed Postgres).
# SHADOW_DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/silsila_shadow?schema=public"

# Gates /admin. Any long random string; there is one admin for now.
ADMIN_PASSWORD="change-me"

# Public origin. Used to resolve the OpenGraph image URL for link previews.
NEXT_PUBLIC_SITE_URL="https://silsila.pk"
